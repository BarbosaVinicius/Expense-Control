@page "/Report"
@inject ReportService ReportService
@inject SessionService SessionService
@inject NavigationManager NavigationManager

<div class="container">
    <!-- Page title section -->
    <div class="text-center">
        <h1>Personal Expense Control</h1>
        <p>Report</p>
        <hr>
    </div>

    <!-- Form section -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <form>
                <div class="row mb-3">
                    <!-- Start Date input field -->
                    <div class="col-md-6">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" id="startDate" class="form-control" @bind="StartDate" />
                    </div>

                    <!-- End Date input field -->
                    <div class="col-md-6">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date" id="endDate" class="form-control" @bind="EndDate" />
                    </div>
                </div>

                <!-- Buttons section -->
                <div class="text-center mt-4">
                    <button type="button" class="btn btn-primary me-2" @onclick="GenerateReport">SEND</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">CANCEL</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Display messages based on state -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <!-- Error message display -->
        <div class="text-center text-danger" style="margin-top: 20px;" role="alert">
            @ErrorMessage
        </div>
    }
    else if (!HasData)
    {
        <!-- No data message display -->
        <div class="text-center text-info" style="margin-top: 20px;" role="alert">
            No data found for the selected date range.
        </div>
    }

    <!-- Report results table -->
    @if (HasData)
    {
        <div class="row justify-content-center mt-4">
            <div class="col-md-8">
                <h3>Results</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Value</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ReportResults)
                        {
                            <tr>
                                <!-- Display each item detail in the table -->
                                <td>@item.Type</td>
                                <td>@item.Name</td>
                                <td>@item.Date.ToShortDateString()</td>
                                <td>@item.Value.ToString("C")</td>
                                <td>@item.Description</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <!-- Display total balance at the end of the table -->
                            <td colspan="3">Total:</td>
                            <td colspan="2" class="text-end">@TotalBalance.ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>

<!-- Logout button positioned at the bottom right -->
<button type="button" class="btn btn-danger position-fixed" style="bottom: 20px; right: 20px;" @onclick="LogOut">
    LOG OUT
</button>

@code
{
    private DateTime StartDate { get; set; } = DateTime.Now; // Initial start date
    private DateTime EndDate { get; set; } = DateTime.Now; // Initial end date
    private List<LocalReportItem> ReportResults { get; set; } = new List<LocalReportItem>(); // List to store report data
    private decimal TotalBalance { get; set; } // Total balance for the report
    private string ErrorMessage { get; set; } // Error message to display
    private bool HasData => ReportResults.Count > 0; // Indicates if there is data to display

    private async Task GenerateReport()
    {
        ErrorMessage = string.Empty;
        ReportResults.Clear();
        TotalBalance = 0;

        // Validate date range
        if (StartDate > EndDate)
        {
            ErrorMessage = "Start date cannot be later than end date.";
            StateHasChanged();
            return;
        }

        try
        {
            // Retrieve the username from the session
            var username = await SessionService.GetSessionAsync();
            if (string.IsNullOrEmpty(username))
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            // Fetch report data from the service
            var serviceResults = await ReportService.GetReportAsync(username, StartDate, EndDate);
            if (serviceResults == null || serviceResults.Count == 0)
            {
                StateHasChanged();
                return;
            }

            // Map service results to local report items
            ReportResults = serviceResults.Select(item => new LocalReportItem
            {
                Type = item.Type,
                Name = item.Name,
                Date = item.Date,
                Value = item.Value,
                Description = item.Description
            }).ToList();

            // Calculate total balance
            TotalBalance = ReportResults.Sum(item => item.Type == "Amount Received" ? item.Value : -item.Value);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Handle any errors that occur
            ErrorMessage = $"An error occurred: {ex.Message}";
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        // Navigate back to the main menu
        NavigationManager.NavigateTo("/MainMenu");
    }

    private async Task LogOut()
    {
        // Clear the session and navigate to the login page
        await SessionService.ClearSessionAsync();
        NavigationManager.NavigateTo("/");
    }

    public class LocalReportItem
    {
        public string Type { get; set; } // Type of the transaction (e.g., income or expense)
        public string Name { get; set; } // Name of the transaction
        public DateTime Date { get; set; } // Date of the transaction
        public decimal Value { get; set; } // Value of the transaction
        public string Description { get; set; } // Description of the transaction
    }
}
