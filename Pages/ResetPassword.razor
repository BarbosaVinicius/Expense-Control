@page "/ResetPassword"
@inject UserService UserService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

@using System.Security.Cryptography
@using System.Text

<div class="container">
    <div class="row align-items-center" style="height: 100vh;">
        <!-- Left column with application title and description -->
        <div class="col-md-6 text-start">
            <h1>Personal Expense Control</h1>
            <p>Reset your Password.</p>
        </div>

        <!-- Right column with reset password form -->
        <div class="col-md-6">
            @if (!IsTokenValid)
            {
                <!-- Display error message if token is invalid -->
                <div class="alert alert-danger" role="alert">
                    Invalid or expired token.
                </div>
            }
            else
            {
                <!-- New password input field -->
                <div class="input-group flex-nowrap mb-3">
                    <input type="password" class="form-control" placeholder="New Password" @bind="NewPassword" maxlength="255" />
                </div>
                <!-- Repeat new password input field -->
                <div class="input-group flex-nowrap mb-3">
                    <input type="password" class="form-control" placeholder="Repeat New Password" @bind="RepeatNewPassword" maxlength="255" />
                </div>
                <!-- Button to execute password reset -->
                <button type="button" class="btn btn-primary w-100 mb-2" @onclick="ExecutePasswordReset">SAVE</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string token { get; set; } // Token passed as a parameter for password reset validation

    private string NewPassword { get; set; } = string.Empty; // Stores the new password
    private string RepeatNewPassword { get; set; } = string.Empty; // Stores the repeated new password
    private bool IsTokenValid { get; set; } = false; // Indicates if the token is valid

    protected override async Task OnInitializedAsync()
    {
        // Check if the token parameter is empty or invalid
        if (string.IsNullOrEmpty(token))
        {
            IsTokenValid = false;
            return;
        }

        try
        {
            // Validate the reset token through the UserService
            IsTokenValid = await UserService.ValidateResetTokenAsync(token);
        }
        catch
        {
            IsTokenValid = false; // Set token as invalid in case of an error
        }
    }

    private async Task ExecutePasswordReset()
    {
        // Validate that both password fields are filled
        if (string.IsNullOrWhiteSpace(NewPassword) || string.IsNullOrWhiteSpace(RepeatNewPassword))
        {
            await JSRuntime.InvokeVoidAsync("alert", "All fields must be filled out.");
            return;
        }

        // Ensure the passwords match
        if (NewPassword != RepeatNewPassword)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Passwords do not match.");
            return;
        }

        try
        {
            // Hash the new password before sending it to the service
            var hashedPassword = HashPassword(NewPassword);
            await UserService.UpdateUserPasswordAsync(token, hashedPassword);
            await JSRuntime.InvokeVoidAsync("alert", "Password has been reset successfully! Redirecting to login...");
            NavigationManager.NavigateTo("/Login"); // Redirect to login page
        }
        catch (Exception ex)
        {
            // Display an error message if the password reset fails
            await JSRuntime.InvokeVoidAsync("alert", $"Error resetting password: {ex.Message}");
        }
    }

    private string HashPassword(string password)
    {
        // Hash the password using SHA256
        using var sha256 = SHA256.Create();
        var bytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(password));
        return Convert.ToBase64String(bytes);
    }
}
