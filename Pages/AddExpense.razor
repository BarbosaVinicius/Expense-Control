@page "/AddExpense"

@inject SessionService SessionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ExpenseService ExpenseService

<div class="container">
    <!-- Title -->
    <div class="text-center"> 
        <h1>Personal Expense Control</h1>
        <p>Add Expense</p>
        <hr>
    </div>

    <!-- Form -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <form>
                <div class="row mb-3">
                    <!-- Name field -->
                    <div class="col-md-4">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" id="name" class="form-control" placeholder="Enter name" maxlength="25" @bind="ExpenseName" />
                    </div>

                    <!-- Date field -->
                    <div class="col-md-4">
                        <label for="date" class="form-label">Date</label>
                        <input type="date" id="date" class="form-control" @bind="ExpenseDate" />
                    </div>

                    <!-- Value field -->
                    <div class="col-md-4">
                        <label for="value" class="form-label">Value</label>
                        <input type="text" id="value" class="form-control" placeholder="Enter value" @bind="ExpenseValue" />
                    </div>
                </div>

                <!-- Description field -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label for="description" class="form-label">Description</label>
                        <input type="text" id="description" class="form-control" placeholder="Enter description"
                            maxlength="75" @bind="ExpenseDescription" />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="text-center mt-4">
                    <button type="button" class="btn btn-success me-2" @onclick="SaveExpense">SAVE</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">CANCEL</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- "LOG OUT" button at the bottom-right corner -->
<button type="button" class="btn btn-danger position-fixed" style="bottom: 20px; right: 20px;" @onclick="LogOut">
    LOG OUT
</button>

@code {
    // Fields for expense information
    private string ExpenseName { get; set; } = string.Empty;
    private DateTime ExpenseDate { get; set; } = DateTime.Now;
    private decimal ExpenseValue { get; set; }
    private string ExpenseDescription { get; set; } = string.Empty;

    // Current logged-in user
    private string CurrentUsername { get; set; } = string.Empty;

    // Method triggered when the component is initialized
    protected override async Task OnInitializedAsync()
    {        
        // Retrieve the current username from the session
        CurrentUsername = await SessionService.GetSessionAsync();

        // Redirect to the home page if the user is not logged in
        if (string.IsNullOrEmpty(CurrentUsername))
        {
            NavigationManager.NavigateTo("/");
            return;
        }
    }

    // Method triggered after the component is rendered for the first time
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Start inactivity timer (30 minutes)
            await JSRuntime.InvokeVoidAsync("startInactivityTimer", DotNetObjectReference.Create(this), 30 * 60 * 1000);
        }
    }

    // Save the expense to the database
    private async Task SaveExpense()
    {
        // Validate fields
        if (string.IsNullOrWhiteSpace(ExpenseName) || ExpenseValue <= 0 || string.IsNullOrWhiteSpace(ExpenseDescription))
        {
            await JSRuntime.InvokeVoidAsync("alert", "All fields must be filled, and Value must be greater than 0.");
            return;
        }        

        try
        {
            // Save expense data in the database
            await ExpenseService.AddExpenseAsync(CurrentUsername, ExpenseName, ExpenseDate, ExpenseValue, ExpenseDescription);

            await JSRuntime.InvokeVoidAsync("alert", "Expense saved successfully!");
            NavigationManager.NavigateTo("/MainMenu");
        }
        catch (Exception ex)
        {
            // Show an error message if the operation fails
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving expense: {ex.Message}");
        }
    }

    // Cancel the operation and navigate to the main menu
    private void Cancel()
    {
        NavigationManager.NavigateTo("MainMenu");
    }

    // Method triggered when the inactivity timeout is reached
    [JSInvokable]
    public async Task OnInactivityTimeout()
    {
        Console.WriteLine("Inactivity timeout reached. Logging out...");
        await LogOut();
    }

    // Log out the user and clear session information
    private async Task LogOut()
    {
        await SessionService.ClearSessionAsync();
        NavigationManager.NavigateTo("/");
    }    
}
