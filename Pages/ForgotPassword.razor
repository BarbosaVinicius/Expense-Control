@page "/ForgotPassword"

@using Microsoft.Extensions.Configuration

@inject EmailService EmailService
@inject UserService UserService
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<div class="container">
    <div class="row align-items-center" style="height: 100vh;">
        <!-- Left column: Application title and instructions -->
        <div class="col-md-6 text-start">
            <h1>Personal Expense Control</h1>
            <p>Enter your email address to receive a reset link.</p>
        </div>

        <!-- Right column: Input form and actions -->
        <div class="col-md-6">
            <!-- Email input field -->
            <div class="input-group mb-3">
                <input type="email" class="form-control" placeholder="Email" @bind="Email" />
            </div>
            <!-- Button to send reset email -->
            <button class="btn btn-primary w-100 mb-3" @onclick="SendResetEmail">Send Reset Email</button>
            <hr>
            <!-- Button to navigate back to the home page -->
            <button type="button" class="btn btn-success w-100" @onclick="NavigateToHomePage">HOME PAGE</button>

            <!-- Feedback message display -->
            @if (!string.IsNullOrEmpty(FeedbackMessage))
            {
                <div class="alert alert-info" role="alert">
                    @FeedbackMessage
                </div>
            }
        </div>
    </div>
</div>

@code
{
    // User-provided email address
    private string Email { get; set; } = string.Empty;

    // Message to display feedback to the user
    private string FeedbackMessage { get; set; } = string.Empty;

    // Method to handle sending the reset email
    private async Task SendResetEmail()
    {
        try
        {
            // Generate a reset token for the provided email
            var token = await UserService.GeneratePasswordResetTokenAsync(Email);

            // Construct the reset link using the application's base URL
            var resetLink = $"{NavigationManager.BaseUri}ResetPassword?token={token}";

            // Email subject and body
            var subject = "Password Reset Request";
            var body = $@"
<p>Click the link below to reset your password:</p>
<a href='{resetLink}'>Reset Password</a>
<p>This link is valid for 1 hour.</p>";

            // Send the reset email
            await EmailService.SendEmailAsync(Email, subject, body);

            // Provide feedback to the user
            FeedbackMessage = "An email has been sent to reset your password.";
        }
        catch (Exception ex)
        {
            // Display error message in case of failure
            FeedbackMessage = $"Error: {ex.Message}";
        }
    }

    // Method to navigate back to the home page
    private void NavigateToHomePage()
    {
        NavigationManager.NavigateTo("/");
    }
}
