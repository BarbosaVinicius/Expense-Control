@page "/MainMenu"

@inject NavigationManager NavigationManager
@inject SessionService SessionService
@inject IJSRuntime JSRuntime

<div class="container">
    <!-- Title -->
    <div class="text-center">
        <h1>Personal Expense Control</h1>
        <p>Welcome @Username!</p>
        <hr>
    </div>

    <!-- Centralized cards for main menu options -->
    <div class="row justify-content-center align-items-stretch mt-4">
        <!-- Card "Add Expense" -->
        <div class="col-md-3">
            <div class="card text-center h-100" style="cursor: pointer;" title="Click to add expense" @onclick="NavigateToAddExpense">
                <div class="card-body d-flex flex-column">
                    <i class="bi bi-wallet2 display-4 mb-3 text-primary"></i>
                    <h5 class="card-title">Add Expense</h5>
                    <p class="card-text flex-grow-1">Record your expenses to keep your finances in check.</p>
                </div>
            </div>
        </div>       

        <!-- Card "Amount Received" -->
        <div class="col-md-3">
            <div class="card text-center h-100" style="cursor: pointer;" title="Click to track income" @onclick="NavigateToAmountReceived">
                <div class="card-body d-flex flex-column">
                    <i class="bi bi-currency-dollar display-4 mb-3 text-warning"></i>
                    <h5 class="card-title">Amount Received</h5>
                    <p class="card-text flex-grow-1">Track the money you have received.</p>
                </div>
            </div>
        </div>

        <!-- Card "Report" -->
        <div class="col-md-3">
            <div class="card text-center h-100" style="cursor: pointer;" title="Click to view reports" @onclick="NavigateToReport">
                <div class="card-body d-flex flex-column">
                    <i class="bi bi-bar-chart-line display-4 mb-3 text-success"></i>
                    <h5 class="card-title">Report</h5>
                    <p class="card-text flex-grow-1">View detailed reports of your expenses.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- "LOG OUT" button in the bottom-right corner -->
<button type="button" class="btn btn-danger position-fixed" style="bottom: 20px; right: 20px;" @onclick="LogOut">
    LOG OUT
</button>

@code {
    // The username of the current user, retrieved from the session
    [Parameter]
    public string Username { get; set; }

    // Called during the component initialization process
    protected override async Task OnInitializedAsync()
    {
        // Retrieve the current username from the session
        var currentUsername = await SessionService.GetSessionAsync();

        // Redirect to the login page if no session is found
        if (string.IsNullOrEmpty(currentUsername))
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        Username = currentUsername;

        Console.WriteLine($"Username received from session: {Username}");
    }

    // Triggered after the component has been rendered for the first time
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Starts the inactivity timer for automatic logout after 30 minutes
            await JSRuntime.InvokeVoidAsync("startInactivityTimer", DotNetObjectReference.Create(this), 30 * 60 * 1000);
        }
    }

    // Navigate to the "Add Expense" page
    private void NavigateToAddExpense()
    {
        NavigationManager.NavigateTo("/AddExpense");
    }

    // Navigate to the "Report" page
    private void NavigateToReport()
    {
        NavigationManager.NavigateTo("/Report");
    }

    // Navigate to the "Amount Received" page
    private void NavigateToAmountReceived()
    {
        NavigationManager.NavigateTo("/AmountReceived");
    }

    // Called when the inactivity timeout is reached
    [JSInvokable]
    public async Task OnInactivityTimeout()
    {
        Console.WriteLine("Inactivity timeout reached. Logging out...");
        await LogOut();
    }

    // Logs the user out and clears session data
    private async Task LogOut()
    {
        // Clear the session information
        await SessionService.ClearSessionAsync();

        // Navigate back to the login page
        NavigationManager.NavigateTo("/");
    }
}
