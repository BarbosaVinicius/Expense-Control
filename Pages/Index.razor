@page "/"

@inject UserService UserService
@inject SessionService SessionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="container">
    <div class="row align-items-center" style="height: 100vh;">
        <!-- Left column: Application title and tagline -->
        <div class="col-md-6 text-start">
            <h1>Personal Expense Control</h1>
            <p>Get your life in order.</p>
        </div>

        <!-- Right column: Login form -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <!-- Username input field -->
                    <div class="input-group flex-nowrap mb-3">
                        <input type="text" class="form-control" placeholder="Username" @bind="Username"
                            aria-label="Username" aria-describedby="addon-wrapping">
                    </div>

                    <!-- Password input field with toggle visibility button -->
                    <div class="input-group flex-nowrap mb-3">
                        <input type="@PasswordInputType" class="form-control" placeholder="Password" @bind="Password"
                            aria-label="Password" aria-describedby="addon-wrapping">
                        <button class="btn btn-outline-secondary" type="button" id="toggle-password"
                            @onclick="TogglePasswordVisibility"><i class="@PasswordIconClass"></i></button>
                    </div>

                    <!-- Login button -->
                    <button type="button" class="btn btn-primary w-100 mb-2" @onclick="HandleLogin">ENTER</button>

                    <!-- Forgot password link -->
                    <p class="text-center mb-2">
                        <a href="/ForgotPassword" class="text-decoration-none">Forgot your password?</a>
                    </p>

                    <hr>

                    <!-- Button to navigate to account creation -->
                    <button type="button" class="btn btn-success w-100" @onclick="NavigateToNewAccount">CREATE A NEW ACCOUNT</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code
{
    // The entered username
    private string Username { get; set; } = string.Empty;

    // The entered password
    private string Password { get; set; } = string.Empty;

    // Indicates whether the password is visible
    private bool IsPasswordVisible { get; set; } = false;

    // Determines the input type for the password field based on its visibility
    private string PasswordInputType => IsPasswordVisible ? "text" : "password";

    // Determines the icon class for the password visibility toggle button
    private string PasswordIconClass => IsPasswordVisible ? "bi bi-eye-slash" : "bi bi-eye";

    // Toggles the visibility of the password field
    private void TogglePasswordVisibility()
    {
        IsPasswordVisible = !IsPasswordVisible;
    }

    // Handles the login process
    private async Task HandleLogin()
    {
        try
        {
            // Logs the login attempt for debugging
            Console.WriteLine($"Attempting to validate: Username={Username}, Password={Password}");

            // Validates the provided credentials
            var isValid = await UserService.ValidateCredentialsAsync(Username, Password);

            if (isValid)
            {
                // Logs success and navigates to the main menu
                Console.WriteLine("Credentials are valid. Navigating to MainMenu.");
                await SessionService.SetSessionAsync(Username);
                NavigationManager.NavigateTo($"/MainMenu");
            }
            else
            {
                // Logs failure and shows an alert to the user
                Console.WriteLine("Invalid credentials.");
                await JSRuntime.InvokeVoidAsync("alert", "Invalid username or password. Have you registered?");
            }
        }
        catch (Exception ex)
        {
            // Logs the error and shows an alert to the user
            Console.WriteLine($"Error occurred: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"An error occurred: {ex.Message}");
        }
    }

    // Navigates to the account creation page
    private void NavigateToNewAccount()
    {
        NavigationManager.NavigateTo("/NewAccount");
    }
}
