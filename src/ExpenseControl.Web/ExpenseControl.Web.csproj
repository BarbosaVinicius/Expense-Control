<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ExpenseControl.Web</RootNamespace>
    <AssemblyName>ExpenseControl.Web</AssemblyName>
    <!-- Lets `dotnet user-secrets` keep production-like secrets out of the repository. -->
    <UserSecretsId>6f1c1f3e-8f0e-4f3a-9b6d-2d5b0e9a7c41</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseControl.Core\ExpenseControl.Core.csproj" />
    <ProjectReference Include="..\ExpenseControl.Infrastructure\ExpenseControl.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI texts, one file per language (see Localization/TranslationStore.cs). -->
    <EmbeddedResource Include="Localization\Resources\*.json" />
  </ItemGroup>

</Project>
