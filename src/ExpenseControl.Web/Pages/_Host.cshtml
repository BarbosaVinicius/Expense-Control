@page "/"
@namespace ExpenseControl.Web.Pages
@using ExpenseControl.Web.Components
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Expense Control</title>
    <base href="~/" />
    <!-- Applies the saved theme before the first paint, so there is no flash of the wrong one. -->
    <script src="js/prefs.js"></script>
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/site.css" />
</head>
<body>
    <!-- Not prerendered: the sign-in state, language and theme live in the browser and are read through JS interop. -->
    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="lib/chartjs/chart.umd.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
