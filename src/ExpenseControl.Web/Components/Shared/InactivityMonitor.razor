@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SessionAuthenticationStateProvider Session
@inject NavigationManager Navigation
@inject IOptions<SessionOptions> Options

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<InactivityMonitor>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/inactivity.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("start", _self, Options.Value.InactivityTimeoutMinutes * 60_000);
    }

    [JSInvokable]
    public async Task OnInactive()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("/?notice=expired");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; the browser dropped the listeners with the page.
            }
        }

        _self?.Dispose();
    }
}
