@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="chart-box">
    <canvas @ref="_canvas"></canvas>
</div>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string? _drawn;

    [Parameter, EditorRequired] public ChartSpec Spec { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page rebuilds the spec on every render; only draw again when its content really changed.
        var signature = JsonSerializer.Serialize(Spec);
        if (signature == _drawn)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await _module.InvokeVoidAsync("render", _canvas, Spec);
            _drawn = signature;
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended while drawing.
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("dispose", _canvas);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Nothing to clean up: the browser dropped the page.
        }
    }
}
