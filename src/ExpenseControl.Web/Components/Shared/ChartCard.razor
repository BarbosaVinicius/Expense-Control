<div class="card h-100">
    <div class="card-body chart-card-body">
        <div class="chart-card-head">
            <div>
                <h2>@Title</h2>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p>@Subtitle</p>
                }
            </div>

            @if (TableContent is not null)
            {
                <div class="segmented" role="group" aria-label="@L["chart.view"]">
                    <button type="button" class="@(_table ? null : "active")" @onclick="() => _table = false"
                            title="@L["chart.viewChart"]" aria-label="@L["chart.viewChart"]" aria-pressed="@(_table ? "false" : "true")">
                        <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="@(_table ? "active" : null)" @onclick="() => _table = true"
                            title="@L["chart.viewTable"]" aria-label="@L["chart.viewTable"]" aria-pressed="@(_table ? "true" : "false")">
                        <i class="bi bi-table" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>

        @if (_table && TableContent is not null)
        {
            <div class="table-responsive chart-table">
                @TableContent
            </div>
        }
        else
        {
            <div class="chart-fill">@ChartContent</div>
        }
    </div>
</div>

@code {
    private bool _table;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public RenderFragment? ChartContent { get; set; }

    /// <summary>The same numbers as a table: the accessible alternative to the chart.</summary>
    [Parameter] public RenderFragment? TableContent { get; set; }
}
