@page "/"
@layout AuthLayout
@inject AuthService Auth
@inject SessionAuthenticationStateProvider Session
@inject NavigationManager Navigation
@inject ILogger<Index> Logger

<div class="card auth-card">
    <h2 class="mb-1">@L["login.title"]</h2>
    <p class="text-muted-ec mb-4">@L["login.subtitle"]</p>

    @if (NoticeText is not null)
    {
        <div class="alert alert-info" role="status">@NoticeText</div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <EditForm Model="_model" OnSubmit="SignInAsync" novalidate>
        <div class="mb-3">
            <label class="form-label" for="login-username">@L["field.username"]</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                <InputText id="login-username" class="@FieldClass("username")" @bind-Value="_model.Username"
                           autocomplete="username" maxlength="@AccountRules.MaxUsernameLength" />
            </div>
            <FieldError Message="@Error("username")" />
        </div>

        <div class="mb-2">
            <label class="form-label" for="login-password">@L["field.password"]</label>
            <PasswordInput Id="login-password" @bind-Value="_model.Password" Autocomplete="current-password"
                           HasError="@HasError("password")" />
            <FieldError Message="@Error("password")" />
        </div>

        <div class="text-end mb-4">
            <a href="ForgotPassword" class="small text-decoration-none">@L["login.forgot"]</a>
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            @L["login.submit"]
        </button>
    </EditForm>

    <hr class="my-4">

    <p class="text-center text-muted-ec mb-3">@L["login.noAccount"]</p>
    <a class="btn btn-outline-secondary w-100" href="NewAccount">@L["login.create"]</a>
</div>

@code {
    private readonly LoginModel _model = new();
    private readonly Dictionary<string, string> _errors = [];
    private bool _busy;
    private string? _error;

    // Set through the query string (e.g. /?notice=registered) by pages that send the user back here.
    [Parameter, SupplyParameterFromQuery(Name = "notice")]
    public string? Notice { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? NoticeText => Notice switch
    {
        "registered" => L["notice.registered"],
        "reset" => L["notice.reset"],
        "expired" => L["notice.expired"],
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        // Someone who is already signed in has no use for the login form.
        if (AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/dashboard", replace: true);
        }
    }

    private string? Error(string field) => _errors.GetValueOrDefault(field);

    private bool HasError(string field) => _errors.ContainsKey(field);

    private string FieldClass(string field) => "form-control" + (HasError(field) ? " is-invalid" : string.Empty);

    private async Task SignInAsync()
    {
        _errors.Clear();
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.Username))
        {
            _errors["username"] = L["validation.required"];
        }

        if (string.IsNullOrEmpty(_model.Password))
        {
            _errors["password"] = L["validation.required"];
        }

        if (_errors.Count > 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.LoginAsync(_model.Username, _model.Password);
            if (!result.Succeeded)
            {
                _error = L.Error(result);
                _model.Password = string.Empty;
                return;
            }

            await Session.SignInAsync(result.Value!.Username);
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sign-in failed unexpectedly.");
            _error = L["error.generic"];
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }
}
