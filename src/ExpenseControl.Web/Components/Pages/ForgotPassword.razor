@page "/ForgotPassword"
@layout AuthLayout
@using ExpenseControl.Web.Services
@inject AuthService Auth
@inject NavigationManager Navigation
@inject IOptions<AppOptions> AppSettings
@inject ILogger<ForgotPassword> Logger

<div class="card auth-card">
    <h2 class="mb-1">@L["forgot.title"]</h2>
    <p class="text-muted-ec mb-4">@L["forgot.subtitle"]</p>

    @if (_sent)
    {
        <div class="alert alert-info" role="status">@L["forgot.sent"]</div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <EditForm Model="_model" OnSubmit="SendAsync" novalidate>
        <div class="mb-4">
            <label class="form-label" for="forgot-email">@L["field.email"]</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                <InputText id="forgot-email" type="email" class="@("form-control" + (_emailError is null ? "" : " is-invalid"))"
                           @bind-Value="_model.Email" autocomplete="email" />
            </div>
            <FieldError Message="@_emailError" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            @L["forgot.submit"]
        </button>
    </EditForm>

    <hr class="my-4">

    <a class="btn btn-outline-secondary w-100" href=""><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> @L["forgot.back"]</a>
</div>

@code {
    private readonly ForgotModel _model = new();
    private bool _busy;
    private bool _sent;
    private string? _error;
    private string? _emailError;

    private async Task SendAsync()
    {
        _sent = false;
        _error = null;
        _emailError = null;

        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            _emailError = L["validation.required"];
            return;
        }

        _busy = true;
        try
        {
            await Auth.RequestPasswordResetAsync(_model.Email, BuildMessage);
            _sent = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset request failed unexpectedly.");
            _error = L["error.generic"];
        }
        finally
        {
            _busy = false;
        }
    }

    private ExpenseControl.Core.Common.EmailMessage BuildMessage(string token) =>
        PasswordResetEmail.Build(
            L["email.reset.subject"],
            L["email.reset.intro"],
            L["email.reset.button"],
            L["email.reset.expiry", (int)AuthService.ResetTokenLifetime.TotalMinutes],
            L["email.reset.ignore"],
            BuildResetLink(token));

    private string BuildResetLink(string token)
    {
        // Prefer the configured public address: the one of the current request comes from a client-supplied header.
        var configured = AppSettings.Value.PublicBaseUrl;
        var baseUri = string.IsNullOrWhiteSpace(configured) ? Navigation.BaseUri : configured.TrimEnd('/') + "/";
        return $"{baseUri}ResetPassword?token={Uri.EscapeDataString(token)}";
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
