@page "/ResetPassword"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Navigation
@inject ILogger<ResetPassword> Logger

<div class="card auth-card">
    <h2 class="mb-1">@L["reset.title"]</h2>
    <p class="text-muted-ec mb-4">@L["reset.subtitle"]</p>

    @if (!_checked)
    {
        <div class="text-center py-3" role="status"><div class="spinner-border text-primary" aria-hidden="true"></div></div>
    }
    else if (!_tokenValid)
    {
        <div class="alert alert-danger" role="alert">@L["reset.invalid"]</div>
        <a class="btn btn-primary w-100" href="ForgotPassword">@L["reset.requestNew"]</a>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        <EditForm Model="_model" OnSubmit="ResetAsync" novalidate>
            <div class="mb-3">
                <label class="form-label" for="reset-password">@L["field.newPassword"]</label>
                <PasswordInput Id="reset-password" @bind-Value="_model.Password" Autocomplete="new-password"
                               HasError="@(_errors.ContainsKey("password"))" />
                <div class="form-text">@L["field.passwordHint", AccountRules.MinPasswordLength]</div>
                <FieldError Message="@_errors.GetValueOrDefault("password")" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="reset-confirm">@L["field.confirmNewPassword"]</label>
                <PasswordInput Id="reset-confirm" @bind-Value="_model.Confirm" Autocomplete="new-password"
                               HasError="@(_errors.ContainsKey("confirm"))" />
                <FieldError Message="@_errors.GetValueOrDefault("confirm")" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                @L["reset.submit"]
            </button>
        </EditForm>
    }
</div>

@code {
    private readonly ResetModel _model = new();
    private readonly Dictionary<string, string> _errors = [];
    private bool _checked;
    private bool _tokenValid;
    private bool _busy;
    private string? _error;

    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tokenValid = await Auth.IsResetTokenValidAsync(Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not validate a password reset token.");
            _tokenValid = false;
        }

        _checked = true;
    }

    private async Task ResetAsync()
    {
        _errors.Clear();
        _error = null;

        if (string.IsNullOrEmpty(_model.Password)) { _errors["password"] = L["validation.required"]; }
        if (_model.Confirm != _model.Password) { _errors["confirm"] = L["validation.mismatch"]; }

        if (_errors.Count > 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.ResetPasswordAsync(Token, _model.Password);
            if (!result.Succeeded)
            {
                _error = L.Error(result);
                return;
            }

            Navigation.NavigateTo("/?notice=reset");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset failed unexpectedly.");
            _error = L["error.generic"];
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ResetModel
    {
        public string Password { get; set; } = string.Empty;

        public string Confirm { get; set; } = string.Empty;
    }
}
